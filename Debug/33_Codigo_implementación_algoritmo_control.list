08001554 <KalmanFilter_F>:

void KalmanFilter_Yiorderfilter(KalmanFilter *kf, float angle_m, float gyro_m, float dt, float K1){
	kf->angle6 = K1*angle_m + (1.0f - K1) * (kf->angle6 + gyro_m * dt);
}

